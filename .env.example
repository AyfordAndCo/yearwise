# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres. In production this is the Supabase pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yearwise?schema=public"

# Direct (non-pooled) connection. Prisma migrations need this.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/yearwise?schema=public"

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Error tracking
SENTRY_DSN=""

# Optional, but without them a production stack trace stays minified and errors
# cannot be attributed to a release. Create a token under Settings > Auth Tokens
# with the `project:releases` and `org:read` scopes.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"